<Project>
	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>
	<PropertyGroup>
		<Authors>Royal Code</Authors>
		<Copyright>Royal Code Copyright ©  2025</Copyright>
		<RepositoryUrl>https://github.com/Royal-Code/SmartCommands</RepositoryUrl>
		<RepositoryType>Git</RepositoryType>
		<Configurations>Debug;Release</Configurations>
		<PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
	</PropertyGroup>
	<PropertyGroup>
		<SmartProblemsVer>1.0.0-preview-3.0</SmartProblemsVer>
		<SmartValidationsVer>1.0.0-preview-1.0</SmartValidationsVer>
		<WorkContextVer>1.0.0-preview-8.2</WorkContextVer>
		<ExSrcGenVer>0.1.1</ExSrcGenVer>
	</PropertyGroup>
</Project>
