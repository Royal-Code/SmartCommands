<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="../pack.targets"/>
	
	<PropertyGroup>
		<TargetFrameworks>$(LibFrwkVer)</TargetFrameworks>
		<Description>WorkContext adapters and optimistic-concurrency retry integration for SmartCommands.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" Condition="'$(TargetFramework)' == 'net8.0'" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.0" Condition="'$(TargetFramework)' == 'net9.0'" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="$(ExtVer)" />
		<PackageReference Include="RoyalCode.WorkContext.EntityFramework" Version="$(WorkContextVer)" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\RoyalCode.SmartCommands\RoyalCode.SmartCommands.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <InternalsVisibleTo Include="RoyalCode.SmartCommands.Demo.Tests" />
	</ItemGroup>

</Project>
